# sketchybar 設定（統一ミニマル: UDEV Gothic NF + tmux パレット配色）
# 全オプション: https://felixkratz.github.io/SketchyBar/config/bar
#
# 設計方針（.claude/specs/2026-08-04-wm-additional-config-design.md）:
# - WS ウィジェットは aerospace のイベント駆動（exec-on-workspace-change → --trigger）。
#   ポーリング・動的なアイテム追加削除はしない。
# - 配色は tmux パレット（.tmux.conf の Color palette 節）と揃える。形式は 0xAARRGGBB。
# - Nerd Font アイコンは Material Design 系（U+F0000 台）のみ使う（CLAUDE.md の tmux 節と同じ理由）。

PLUGIN_DIR="$CONFIG_DIR/plugins"

# tmux パレット対応色（フォーカス WS の配色は plugins/aerospace.sh 側にも同値を持つ）
COLOR_BAR=0xe61c1c1c # @c-bg #1c1c1c（バー背景。透過 e6 + blur）
COLOR_FG=0xffc0c0c0  # @c-fg #c0c0c0

##### Bar Appearance #####
# NOTE: 実下端 35px は aerospace.toml の gaps.outer.top が前提にする値。
# 表示を詰める目的で height=40 y_offset=-5 とすると下端は同じ 35px でも、
# アイテム（バー全体の垂直中央に配置される）が見えている領域の中央より上にずれる。
# height 自体を 35 にして中央揃えを保つ
sketchybar --bar position=top height=35 blur_radius=30 color=$COLOR_BAR

##### Changing Defaults #####
default=(
  padding_left=5
  padding_right=5
  icon.font="UDEV Gothic NF:Bold:17.0"
  label.font="UDEV Gothic NF:Bold:14.0"
  icon.color=$COLOR_FG
  label.color=$COLOR_FG
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### aerospace ワークスペース #####
# aerospace 側の exec-on-workspace-change がこのイベントを FOCUSED_WORKSPACE 付きで trigger する
sketchybar --add event aerospace_workspace_change

# alt-1〜9 に対応する space.1〜9 を静的に生成する。表示/非表示と配色、
# label（WS 内アプリのアイコン列）は plugins/aerospace.sh が判定する
# （非空 or フォーカス中のみ表示。label は sketchybar-app-font のリガチャ）
for sid in 1 2 3 4 5 6 7 8 9
do
  space=(
    icon="$sid"
    icon.padding_left=7
    icon.padding_right=7
    label.font="sketchybar-app-font:Regular:16.0"
    label.y_offset=-2
    label.padding_right=7
    background.corner_radius=5
    background.height=25
    background.drawing=off
    label.drawing=off
    drawing=off
    script="$PLUGIN_DIR/aerospace.sh $sid"
    # 切替の着地検証は alt-N と同じ ws-focus.sh に寄せる（フォーカス横取り対策）
    click_script="$HOME/.config/aerospace/ws-focus.sh $sid"
  )
  sketchybar --add item space."$sid" left \
             --set space."$sid" "${space[@]}" \
             --subscribe space."$sid" aerospace_workspace_change
done

##### Adding Left Items #####
# front_app の icon は自アプリのリガチャアイコン（plugins/front_app.sh が設定）。
# y_offset=-2 は sketchybar-app-font のグリフが UDEV Gothic の文字よりベースライン上に
# 高く描かれるための補正（WS チップの label.y_offset と同値。目視で合わせた値）
sketchybar --add item front_app left \
           --set front_app icon.font="sketchybar-app-font:Regular:16.0" \
                 icon.y_offset=-2 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Adding Right Items #####
# ime はイベントが無いためポーリング（update_freq=1）。最後に追加して battery の左
# （右側グループの最左）に置く。icon は使わないが、空のままだと icon の既定 padding
# だけが残り左に空きすぎるため明示 off。label 単独のアイテムは icon+label 構成の
# 隣接アイテムより文字が 2px 上に描かれるため y_offset で補正
# （-2 で隣の数字と完全に揃うが、少し上げた -1 が好み）。
# 右側は既定の item padding（5+5）だとアイテム間が間延びするため padding_left=0 で
# 詰める（間隔は前後の icon/label padding 等の計 13px になる）。アイテム内の
# アイコン↔数字も既定の 8px では広いので label.padding_left=0 の 4px にする
# （icon.padding_right まで 0 にするとグリフと数字が接触するため残す）。
# battery の MD バッテリーグリフは縦長で、既定の 17pt では数字より縦にはみ出して
# 見えるため 14pt に下げて高さを揃える
sketchybar --add item clock right \
           --set clock update_freq=10 padding_left=0 label.padding_left=0 icon=󰥔 \
                 script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume padding_left=0 label.padding_left=0 script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 padding_left=0 label.padding_left=0 \
                 icon.font="UDEV Gothic NF:Bold:14.0" \
                 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item ime right \
           --set ime update_freq=1 icon.drawing=off label.y_offset=-1 \
                 script="$PLUGIN_DIR/ime.sh"

##### Apple Music #####
# Music.app は再生/一時停止/曲変更のたびに com.apple.Music.playerInfo を
# distributed notification として発行する。これをカスタムイベント化して購読し、
# ポーリングなしで再生中トラックを表示する（取得ロジックは plugins/music.sh）。
# ime の後に追加 = 右側グループの最左。可変長ラベルが clock/volume/battery の
# 位置を揺らさないための配置。初期 drawing=off で、末尾の --update が状態を確定する。
# バー上は曲名のみ短め（15文字）に抑え、フル情報（曲名/アーティスト/アルバム）は
# ホバーで開く popup 3行に寄せる。popup の中身は music_change 時に music.sh が
# 事前セットするため、ホバー時は popup.drawing のトグルだけで即表示できる
sketchybar --add event music_change "com.apple.Music.playerInfo" \
           --add item music right \
           --set music drawing=off padding_left=0 label.padding_left=0 \
                 label.max_chars=15 \
                 popup.background.color=$COLOR_BAR \
                 popup.background.corner_radius=5 \
                 popup.blur_radius=30 \
                 script="$PLUGIN_DIR/music.sh" \
           --subscribe music music_change mouse.entered mouse.exited \
           --add item music.title popup.music \
           --set music.title icon=󰝚 \
           --add item music.artist popup.music \
           --set music.artist icon=󰀄 \
           --add item music.album popup.music \
           --set music.album icon=󰀥

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
