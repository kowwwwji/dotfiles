#!/bin/sh
# JankyBorders 起動設定（borders が起動時に実行する sh スクリプト）
# https://github.com/FelixKratz/JankyBorders
#
# 色:
# - active:   白 (#FFFFFF)。どの壁紙・アプリ配色でもフォーカスが一目で分かる
# - inactive: tmux パレット（.tmux.conf の Color palette 節）の @c-primary 紫灰 (#5f5f87)。目立たせない

borders style=round width=7.0 hidpi=on \
  active_color=0xffffffff \
  inactive_color=0xff5f5f87
